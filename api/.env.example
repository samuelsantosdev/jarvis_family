# ── Application ───────────────────────────────────────────────────────────────
# Public base URL of the API (used to build email confirmation links)
APP_HOST=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./jarvis.db

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# For Gmail: enable "App Passwords" in your Google account and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME=Jarvis Family
EMAILS_FROM_EMAIL=your-email@gmail.com

# ── Auth0 (social login – Gmail, Apple, etc.) ─────────────────────────────────
# Create a Regular Web Application in https://manage.auth0.com and fill in:
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL=http://localhost:8000/auth/social/callback
